{
	"name": "otp-giar",
	"version": "1.0.0",
	"description": "SDK and CLI for giar otp: share self-destructing, end-to-end encrypted secrets from code and CI pipelines",
	"keywords": [
		"secret",
		"one-time-secret",
		"password-sharing",
		"end-to-end-encryption",
		"self-destructing",
		"aes-gcm",
		"cli",
		"ci"
	],
	"homepage": "https://otp.giar.digital/docs",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/thegiommi/otp-giar.git",
		"directory": "sdks/js"
	},
	"bugs": "https://github.com/thegiommi/otp-giar/issues",
	"author": "GIAR Digital",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"otp-giar": "dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"prepack": "npm run build"
	},
	"engines": {
		"node": ">=20"
	},
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	}
}
