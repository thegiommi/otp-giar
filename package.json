{
	"name": "otp-giar",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"start": "node --disable-warning=ExperimentalWarning build",
		"apikey": "node --disable-warning=ExperimentalWarning scripts/api-keys.ts",
		"test:e2e": "node --test sdks/js/test/e2e.test.ts"
	},
	"devDependencies": {
		"@fontsource-variable/archivo": "^5.3.0",
		"@fontsource/fragment-mono": "^5.3.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.6.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"engines": {
		"node": ">=22.18"
	}
}
